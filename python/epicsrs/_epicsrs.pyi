    disconnected, 6 an access-rights `(read, write)` pair.
    """

    def __init__(self) -> None: ...
    def __len__(self) -> int: ...
    def subscribe(
        self,
        channel: CaChannel,
        deadband: float = 0.0,
        mask: int | None = None,
        enum_as_string: bool = False,
        float_as_string: bool = False,
        count: int = 0,
        connect_timeout: float | None = None,
        values: bool = True,
        values_max_count: int | None = None,
    ) -> int: ...
    def close_subscription(self, id: int) -> None: ...
    def pause(self, id: int) -> None: ...
    def resume(self, id: int) -> None: ...
    def recv_batch(
        self, max_items: int = 0, timeout: float | None = None
    ) -> list[tuple[int, int, Any]] | None: ...
    def recv_batch_async(
        self, max_items: int = 0, timeout: float | None = None
    ) -> Awaitable[list[tuple[int, int, Any]] | None]: ...
    def close(self) -> None: ...

