class PutOp:
    """A put between its two phases: opened on the server (its type known,
    the current value read on the same operation when begun with `fetch`)
    and not yet committed. Dropped uncommitted, it is destroyed.
    """

    @property
    def type(self) -> Type: ...
    def current(self) -> Value | None: ...
    def commit_async(self, value: Value, timeout: float | None = None) -> Awaitable[None]: ...

class PvaMonitorHub:
    """One queue fed by every PVA monitor opened through it.

    `recv_batch` items are `(id, kind, payload)`: kind 0 a `Value`, 1 the
    server address the monitor connected to, 2/3 (`None`) disconnected /
    finished.
    """

    def __init__(self) -> None: ...
    def __len__(self) -> int: ...
    def subscribe(
        self, context: PvaContext, name: str, request: str | None = None, limit: int | None = None
    ) -> int: ...
    def close_subscription(self, id: int) -> None: ...
    def pause(self, id: int) -> None: ...
    def resume(self, id: int) -> None: ...
    def recv_batch(self, timeout: float | None = None) -> list[tuple[int, int, Any]] | None: ...
    def recv_batch_async(
        self, timeout: float | None = None
    ) -> Awaitable[list[tuple[int, int, Any]] | None]: ...
    def close(self) -> None: ...

