"""Type stubs for the `epicsrs._epicsrs` extension.

Hand-written from the pyo3 surface in `src/`; `tests/test_stubs.py`
checks every name, member and parameter list against the built module.
"""

from collections.abc import Awaitable, Iterator, Mapping, Sequence
from typing import Any, ClassVar

__version__: str

def ca_message(status: int) -> str: ...

# ---------------------------------------------------------------------------
# Exceptions
# ---------------------------------------------------------------------------

class CaError(Exception):
    """Channel Access operation failed; args are (message, eca_status)."""

    @property
    def status(self) -> int: ...

class CaTimeout(CaError): ...
class CaDisconnected(CaError): ...

class PvaError(Exception): ...
class PvaTimeout(PvaError): ...
class PvaDisconnected(PvaError): ...
class PvaRemoteError(PvaError): ...

